# FairCoin App - Environment Variables
# Light & Truth • Love & Mercy • Just & Peace

# Exchange Service URL (local development)
# Exchange Service API URL
NEXT_PUBLIC_EXCHANGE_API_URL=http://localhost:8088

# Frontend API URL
NEXT_PUBLIC_API_BASE=http://localhost:8090/api/v1

# xdiscord Chat Application URL
# Local development: Run xdiscord on port 3031
# Production: Deploy xdiscord separately and update URL
NEXT_PUBLIC_CHAT_URL=http://localhost:3031

# Production URLs (uncomment for production)
# NEXT_PUBLIC_EXCHANGE_API_URL=https://exchange.faircoin.app
# NEXT_PUBLIC_API_BASE=https://api.faircoin.app/api/v1
# NEXT_PUBLIC_CHAT_URL=https://chat.faircoin.app
