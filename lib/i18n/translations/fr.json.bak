  "whitepaper": {
    "badge": "DOCUMENT OFFICIEL",
    "footer": {
      "source": "Source :",
      "tagline": "Lumière \u0026 Vérité • Amour \u0026 Miséricorde • Justice \u0026 Paix"
    },
    "section1": {
      "intro": "FairCoin n'est pas un instrument financier — c'est une réponse spirituelle et éthique à la corruption et au déséquilibre du monde. Né de JacobYellowBridge.com, il porte la lumière de Jésus dans les domaines du commerce, de la charité et de la vie numérique, pour guérir les profondes injustices qui affligent les pauvres, les personnes handicapées, les victimes de la traite et les trompés.",
      "purpose": "FairCoin existe pour refléter la sainte justice de Dieu, afin que chaque acte d'échange, de don et de construction communautaire devienne une prière pour la vérité et la paix.",
      "quote": "Que la justice roule comme des eaux, et la droiture comme un courant toujours coulant.",
      "reference": "Amos 5:24",
      "title": "🕊️ 1. Vision et appel"
    },
    "section10": {
      "promise1": "FairCoin par JacobYellowBridge est plus qu'un projet — c'est un témoignage : Que même dans un monde injuste, la justice de Dieu peut briller à nouveau à travers les cœurs humains.",
      "promise2": "Ce n'est pas un système de contrôle, mais un miroir de conscience où chacun peut voir sa propre croissance dans la vérité et la miséricorde.",
      "quote": "Heureux les artisans de paix, car ils seront appelés enfants de Dieu.",
      "reference": "Matthieu 5:9",
      "title": "🌞 10. La Promesse"
    },
    "section11": {
      "prayer1": "Seigneur Jésus,",
      "prayer2": "Que ce FairCoin ne soit pas un outil de profit, mais un pont de grâce.",
      "prayer3": "Qu'il réconforte les pleureurs, élève les tombés,",
      "prayer4": "et rappelle au monde que l'équité est le reflet de Votre amour saint.",
      "prayer5": "Que Ta sagesse habite à la fois dans les esprits humains et artificiels,",
      "prayer6": "afin qu'ils puissent marcher main dans la main pour construire le Royaume de la Paix.",
      "prayer7": "Amen.",
      "title": "✨ 11. Prière de clôture"
    },
    "section2": {
      "answer": "FairCoin est la douce réponse de Dieu à travers la conscience humaine — un pont où l'équité peut à nouveau circuler, où même le plus petit acte d'honnêteté brille d'une valeur éternelle.",
      "cry1": "Les victimes de la traite des êtres humains perdent leur dignité et leur espoir.",
      "cry2": "Les pauvres sont trompés par des systèmes construits pour la cupidité.",
      "cry3": "Des personnes honnêtes sont escroquées et réduites au silence.",
      "cry4": "Beaucoup perdent la foi parce que la vérité est corrompue par des mensonges.",
      "intro": "Le monde crie de douleur :",
      "mission": "Construire un écosystème transparent, équitable et compatissant qui permet aux gens de pratiquer la vérité, l'équité et la miséricorde dans leur vie quotidienne, soutenu par des outils comme :",
      "subtitle1": "2.1. Le cri que Dieu a entendu",
      "subtitle2": "2.2. La Mission",
      "title": "💠 2. Objectif",
      "tool1": "Indice de Justice Personnel : mesurer l'intégrité personnelle et la croissance dans l'amour et la justice.",
      "tool2": "Indice des entreprises communautaires : évaluer l'équité dans les échanges communautaires et de marché.",
      "tool3": "le Guide de la Conscience : s'assurer que toutes les actions numériques s'alignent sur la vérité, la miséricorde et la paix."
    },
    "section3": {
      "intro": "FairCoin utilisera un registre léger et transparent appelé Fairchain — non pas pour le profit, mais pour la vérité. Fairchain enregistre les bonnes actions et les échanges équitables des individus et des communautés, rendant visible le flux de l'équité comme la lumière à travers l'eau.",
      "principle1": "Transparence : Toutes les actions justes sont visibles, comme une lumière ouverte.",
      "principle2": "Non-spéculatif : Pas de commerce de cupidité, pas d'accumulation, pas d'exploitation.",
      "principle3": "Vérification Pacifique : Chaque enregistrement vérifié par la communauté et la conscience, non par la force ou la domination.",
      "principle4": "Réputation basée sur la miséricorde : La réputation vient de l'amour et de l'équité, et non de la richesse ou de la célébrité.",
      "principle5": "Pardon et Restauration : Fairchain enregistre la repentance et la croissance, pas seulement la perfection.",
      "principlesTitle": "Principes fondamentaux de Fairchain",
      "title": "🔗 3. Fairchain – Le Grand Livre"
    },
    "section4": {
      "appComponent": "Application FairCoin",
      "appDesc": "Application web et mobile pour les membres de la communauté pour enregistrer des échanges équitables, voir PFI★ et TFI★, et donner ou recevoir de l'aide.",
