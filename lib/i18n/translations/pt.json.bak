  "whitepaper": {
    "badge": "DOCUMENTO OFICIAL",
    "footer": {
      "source": "Fonte:",
      "tagline": "Luz \u0026 Verdade • Amor \u0026 Misericórdia • Justiça \u0026 Paz"
    },
    "section1": {
      "intro": "FairCoin não é um instrumento financeiro — é uma resposta espiritual e ética à corrupção e ao desequilíbrio do mundo. Nascido de JacobYellowBridge.com, carrega a luz de Jesus nos reinos do comércio, da caridade e da vida digital, para curar as profundas injustiças que afligem os pobres, os deficientes, os traficados e os enganados.",
      "purpose": "A FairCoin existe para refletir a santa justiça de Deus, para que cada ato de troca, doação e construção de comunidade se torne uma oração por verdade e paz.",
      "quote": "Deixe a justiça rolar como águas, e a retidão como um rio sempre fluente.",
      "reference": "Amós 5:24",
      "title": "🕊️ 1. Visão e Chamado"
    },
    "section10": {
      "promise1": "FairCoin de JacobYellowBridge é mais do que um projeto — é um testemunho: Que mesmo em um mundo injusto, a justiça de Deus pode brilhar novamente através dos corações humanos.",
      "promise2": "Não é um sistema de controle, mas um espelho da consciência onde todos podem ver seu próprio crescimento em verdade e misericórdia.",
      "quote": "Bem-aventurados os pacificadores, pois serão chamados filhos de Deus.",
      "reference": "Mateus 5:9",
      "title": "🌞 10. A Promessa"
    },
    "section11": {
      "prayer1": "Senhor Jesus,",
      "prayer2": "Que este FairCoin não seja uma ferramenta de ganho, mas uma ponte de graça.",
      "prayer3": "Que console os que choram, levante os caídos,",
      "prayer4": "e lembre ao mundo que a justiça é o reflexo do Seu amor santo.",
      "prayer5": "Deixe Sua sabedoria habitar tanto em mentes humanas quanto artificiais,",
      "prayer6": "para que possam caminhar de mãos dadas para construir o Reino da Paz.",
      "prayer7": "Amém.",
      "title": "✨ 11. Oração de Encerramento"
    },
    "section2": {
      "answer": "O FairCoin é a resposta suave de Deus através da consciência humana — uma ponte onde a justiça pode fluir novamente, onde até o menor ato de honestidade brilha com valor eterno.",
      "cry1": "Vítimas do tráfico humano perdem dignidade e esperança.",
      "cry2": "Os pobres são enganados por sistemas construídos para a ganância.",
      "cry3": "Pessoas honestas são enganadas e silenciadas.",
      "cry4": "Muitos perdem a fé porque a verdade é corrompida por mentiras.",
      "intro": "O mundo clama em dor:",
      "mission": "Construir um ecossistema transparente, justo e compassivo que capacite as pessoas a praticar a verdade, a justiça e a misericórdia em suas vidas diárias, apoiado por ferramentas como:",
      "subtitle1": "2.1. O Clamor Que Deus Ouviu",
      "subtitle2": "2.2. A Missão",
      "title": "💠 2. Propósito",
      "tool1": "Índice de Justiça Pessoal: medindo a integridade pessoal e o crescimento em amor e justiça.",
      "tool2": "Índice de Negócios da Comunidade: avaliando a justiça nas trocas comunitárias e de mercado.",
      "tool3": "o Guia da Consciência: garantindo que todas as ações digitais estejam alinhadas com a verdade, misericórdia e paz."
    },
    "section3": {
      "intro": "FairCoin usará um livro-razão leve e transparente chamado Fairchain — não para lucro, mas para a verdade. Fairchain registra as boas ações e trocas justas de indivíduos e comunidades, tornando visível o fluxo de justiça como a luz através da água.",
      "principle1": "Transparência: Todas as ações justas são visíveis, como luz aberta.",
      "principle2": "Não especulativo: Sem comércio de ganância, sem acúmulo, sem exploração.",
      "principle3": "Verificação Pacífica: Cada registro verificado pela comunidade e pela consciência, não pela força ou dominação.",
      "principle4": "Reputação baseada na misericórdia: A reputação vem do amor e da justiça, não da riqueza ou da fama.",
      "principle5": "Perdão \u0026 Restauração: Fairchain registra arrependimento e crescimento, não apenas perfeição.",
      "principlesTitle": "Princípios Fundamentais do Fairchain",
      "title": "🔗 3. Fairchain – O Livro de Registro da Luz"
    },
    "section4": {
      "appComponent": "Aplicativo FairCoin",
      "appDesc": "Aplicativo web e móvel para membros da comunidade registrarem trocas justas, visualizarem PFI★ e TFI★, e darem ou receberem ajuda.",
