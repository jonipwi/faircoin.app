  "whitepaper": {
    "badge": "OFFICIEEL WITBOEK",
    "footer": {
      "source": "Bron:",
      "tagline": "Licht \u0026 Waarheid • Liefde \u0026 Genade • Rechtvaardig \u0026 Vrede"
    },
    "section1": {
      "intro": "FairCoin is geen financieel instrument — het is een spirituele en ethische reactie op de corruptie en ongelijkheid in de wereld. Geboren uit JacobYellowBridge.com, draagt het het licht van Jezus de handels-, liefdadigheids- en digitale levenssferen in, om de diepe onrechtvaardigheden te genezen die de armen, de gehandicapten, de verhandelden en de bedrogenen treffen.",
      "purpose": "FairCoin bestaat om de heilige rechtvaardigheid van God te weerspiegelen, zodat elke handeling van uitwisseling, geven en gemeenschapsopbouw een gebed voor waarheid en vrede wordt.",
      "quote": "Laat rechtvaardigheid als wateren neerdalen, en rechtvaardigheid als een eeuwig stromende beek.",
      "reference": "Amos 5:24",
      "title": "🕊️ 1. Visie en Roeping"
    },
    "section10": {
      "promise1": "FairCoin door JacobYellowBridge is meer dan een project — het is een getuigenis: Dat zelfs in een onrechtvaardige wereld, Gods rechtvaardigheid weer kan stralen door menselijke harten.",
      "promise2": "Het is geen controlesysteem, maar een spiegel van geweten waarin iedereen zijn eigen groei in waarheid en genade kan zien.",
      "quote": "Zalig zijn de vredestichters, want zij zullen kinderen van God genoemd worden.",
      "reference": "Mattheüs 5:9",
      "title": "🌞 10. De Belofte"
    },
    "section11": {
      "prayer1": "Heer Jezus,",
      "prayer2": "Laat deze FairCoin geen middel van winst zijn, maar een brug van genade.",
      "prayer3": "Moge het de huilenden troosten, de gevallen oprichten,",
      "prayer4": "en herinner de wereld eraan dat eerlijkheid de weerspiegeling is van Uw heilige liefde.",
      "prayer5": "Laat Uw wijsheid wonen in zowel menselijke als kunstmatige geesten,",
      "prayer6": "zodat zij hand in hand kunnen lopen om het Koninkrijk van Vrede te bouwen.",
      "prayer7": "Amen.",
      "title": "✨ 11. Slotgebed"
    },
    "section2": {
      "answer": "FairCoin is Gods zachte antwoord door het menselijk geweten — een brug waar eerlijkheid weer kan stromen, waar zelfs de kleinste daad van eerlijkheid straalt met eeuwige waarde.",
