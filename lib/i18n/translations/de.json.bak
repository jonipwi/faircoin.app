  "whitepaper": {
    "badge": "OFFIZIELLES WEISSBUCH",
    "footer": {
      "source": "Quelle:",
      "tagline": "Licht \u0026 Wahrheit • Liebe \u0026 Barmherzigkeit • Gerechtigkeit \u0026 Frieden"
    },
    "section1": {
      "intro": "FairCoin ist kein Finanzinstrument — es ist eine spirituelle und ethische Antwort auf die Korruption und das Ungleichgewicht der Welt. Geboren aus JacobYellowBridge.com, trägt es das Licht Jesu in die Bereiche Handel, Wohltätigkeit und digitales Leben, um die tiefen Ungerechtigkeiten zu heilen, die die Armen, die Behinderten, die Menschenhändler und die Getäuschten plagen.",
      "purpose": "FairCoin existiert, um die heilige Fairness Gottes widerzuspiegeln, damit jeder Akt des Austauschs, Gebens und des Gemeinschaftsaufbaus ein Gebet für Wahrheit und Frieden wird.",
      "quote": "Lasst das Recht wie Wasser fließen und die Gerechtigkeit wie einen nie versiegenden Strom.",
      "reference": "Amos 5:24",
      "title": "🕊️ 1. Vision und Berufung"
    },
    "section10": {
      "promise1": "FairCoin von JacobYellowBridge ist mehr als ein Projekt — es ist ein Zeugnis: Dass selbst in einer ungerechten Welt Gottes Gerechtigkeit durch menschliche Herzen wieder leuchten kann.",
      "promise2": "Es ist kein Kontrollsystem, sondern ein Spiegel des Gewissens, in dem jeder sein eigenes Wachstum in Wahrheit und Barmherzigkeit sehen kann.",
      "quote": "Selig sind die Friedensstifter, denn sie werden Kinder Gottes genannt werden.",
      "reference": "Matthäus 5:9",
      "title": "🌞 10. Das Versprechen"
    },
    "section11": {
      "prayer1": "Herr Jesus,",
      "prayer2": "Lass diesen FairCoin kein Werkzeug des Gewinns sein, sondern eine Brücke der Gnade.",
      "prayer3": "Möge es den Weinenden Trost spenden, die Gefallenen erheben,",
      "prayer4": "und die Welt daran erinnern, dass Fairness das Spiegelbild Ihrer heiligen Liebe ist.",
      "prayer5": "Lass deine Weisheit sowohl in menschlichen als auch in künstlichen Köpfen wohnen,",
      "prayer6": "damit sie Hand in Hand das Königreich des Friedens aufbauen können.",
      "prayer7": "Amen.",
      "title": "✨ 11. Abschlussgebet"
    },
    "section2": {
      "answer": "FairCoin ist Gottes sanfte Antwort durch das menschliche Gewissen — eine Brücke, wo Fairness wieder fließen kann, wo selbst die kleinste Handlung der Ehrlichkeit mit ewigem Wert strahlt.",
      "cry1": "Opfer von Menschenhandel verlieren Würde und Hoffnung.",
      "cry2": "Die Armen werden von Systemen betrogen, die für Gier geschaffen wurden.",
      "cry3": "Ehrliche Menschen werden betrogen und zum Schweigen gebracht.",
      "cry4": "Viele verlieren den Glauben, weil die Wahrheit durch Lügen korrumpiert wird.",
      "intro": "Die Welt schreit vor Schmerz:",
      "mission": "Um ein transparentes, faires und mitfühlendes Ökosystem aufzubauen, das Menschen ermächtigt, Wahrheit, Fairness und Barmherzigkeit in ihrem täglichen Leben zu praktizieren, unterstützt durch Werkzeuge wie:",
      "subtitle1": "2.1. Der Schrei, den Gott hörte",
      "subtitle2": "2.2. Die Mission",
      "title": "💠 2. Zweck",
      "tool1": "Persönlicher Fairness-Index: misst persönliche Integrität und Wachstum in Liebe und Gerechtigkeit.",
      "tool2": "Gemeinschafts-Business-Index: Bewertung der Fairness in Gemeinschafts- und Marktplatztransaktionen.",
      "tool3": "der Gewissensführer: sicherstellen, dass alle digitalen Handlungen mit Wahrheit, Barmherzigkeit und Frieden übereinstimmen."
    },
    "section3": {
      "intro": "FairCoin wird ein leichtes, transparentes Hauptbuch namens Fairchain verwenden — nicht zum Profit, sondern zur Wahrheit. Fairchain zeichnet die guten Taten und fairen Austausch von Individuen und Gemeinschaften auf und macht den Fluss der Fairness sichtbar wie Licht durch Wasser.",
      "principle1": "Transparenz: Alle fairen Handlungen sind sichtbar, wie offenes Licht.",
      "principle2": "Nicht spekulativ: Kein Handel aus Gier, kein Horten, keine Ausbeutung.",
      "principle3": "Friedliche Verifizierung: Jeder Eintrag wird von der Gemeinschaft und dem Gewissen verifiziert, nicht durch Gewalt oder Dominanz.",
      "principle4": "Barmherzigkeitsbasierte Reputation: Reputation kommt aus Liebe und Fairness, nicht aus Reichtum oder Ruhm.",
      "principle5": "Vergebung \u0026 Wiederherstellung: Fairchain dokumentiert Buße und Wachstum, nicht nur Perfektion.",
      "principlesTitle": "Kernprinzipien von Fairchain",
      "title": "🔗 3. Fairchain – Das Licht-Ledger"
    },
    "section4": {
      "appComponent": "FairCoin App",
      "appDesc": "Web- und mobile App für Mitglieder der Gemeinschaft, um faire Handelsgeschäfte zu protokollieren, PFI★ und TFI★ anzuzeigen und Hilfe zu geben oder zu erhalten.",
      "appLayer": "Anwendungsschicht",
      "communityComponent": "JacobYellowBridge Netzwerk",
      "communityDesc": "Verbindet Familien, Kirchen und Organisationen in Fairness-Allianzen.",
      "communityLayer": "Gemeinschaftsschicht",
      "component": "Komponente",
