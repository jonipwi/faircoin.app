{
  "name": "@faircoin/app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "exchange:start": "cd ../tools/exchange && go run cmd/server/main.go",
    "neon:start": "cd ../tools/neon.tech && go run main.go",
    "services:start": "concurrently \"npm run neon:start\" \"npm run exchange:start\" \"npm run dev\""
  },
  "dependencies": {
    "next": "14.2.33",
    "react": "^18",
    "react-dom": "^18",
    "swr": "^2.2.4",
    "lucide-react": "latest",
    "next-themes": "^0.2.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "eslint": "^8",
    "eslint-config-next": "14.2.33",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5"
  }
}
